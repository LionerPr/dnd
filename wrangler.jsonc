{
  // «Летопись» на Cloudflare: воркер с API, база D1, живые комнаты на Durable Objects, фронтенд — статикой.
  "name": "dnd",
  "main": "apps/server/src/index.ts",
  // Перед выкладкой собирается интерфейс — отдельная команда сборки в Cloudflare не нужна
  "build": { "command": "pnpm --filter @dnd/web build" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "letopis",
      "database_id": "647f1d1b-2f5b-4cd6-8cbd-a75c99d0b00c"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
